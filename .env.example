# RepoPulse — environment variable template
# Copy this file to .env and fill in real values. Never commit .env.
# All variables without defaults are REQUIRED at startup.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://repopulse:changeme@db:5432/repopulse

# ── Session / security ───────────────────────────────────────────────────────
SESSION_SECRET_KEY=replace-with-a-long-random-string

# ── GitHub OAuth ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-replace-with-your-openai-key
OPENAI_MODEL=gpt-4o

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Analysis limits (all have defaults; override here if needed) ─────────────
MAX_REPO_SIZE_MB=50
MAX_SOURCE_FILES=1000
ANALYSIS_TIMEOUT_SECONDS=300

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
