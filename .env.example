# RepoPulse -- environment variable template
# Copy this file to .env at the repo root and fill in real values. Never commit .env.
#
# Root Compose configuration and backend settings.
# All other variables are loaded by later tasks and are ignored until then.
# Variable names match Architecture section 41 exactly.

# -- Database -----------------------------------------------------------------
POSTGRES_DB=repopulse
POSTGRES_USER=repopulse
POSTGRES_PASSWORD=replace-with-a-long-random-string
# Used for direct local backend runs; Compose overrides this with the postgres service URL.
DATABASE_URL=postgresql+psycopg://repopulse:replace-with-a-long-random-string@localhost:5432/repopulse

# -- Session / security -------------------------------------------------------
# REQUIRED as of task 0.2. Must be a long random string.
SESSION_SECRET=replace-with-a-long-random-string

# -- GitHub OAuth -------------------------------------------------------------
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
# [Proposed] backend-owned credential with no user scopes, for public-data calls
GITHUB_PUBLIC_API_TOKEN=replace-with-a-server-side-public-data-token

# -- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=sk-replace-with-your-openai-key
# Model name chosen in Phase 5.
OPENAI_MODEL=

# -- URLs ---------------------------------------------------------------------
# FRONTEND_URL: the browser-facing origin of the Next.js app.
FRONTEND_URL=http://localhost:3000
# API_BASE_URL: used by the backend to construct absolute callback/redirect URLs.
API_BASE_URL=http://localhost:8000
# Frontend API base URL, exposed to browser code by Next.js.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# -- Analysis limits (all have defaults; override here if needed) -------------
MAX_REPO_SIZE_MB=50
MAX_SOURCE_FILES=1000
ANALYSIS_TIMEOUT_SECONDS=300

# -- Temporary clone directory ------------------------------------------------
# [Proposed] Defaults to the OS temp directory if left empty.
TEMP_CLONE_DIR=
