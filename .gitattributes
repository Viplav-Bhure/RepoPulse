# Normalize line endings on check-in; check out as-is on Windows
* text=auto eol=lf

# Force LF for source and config files
*.py     text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.sql    text eol=lf
*.sh     text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf

# Keep Windows-native line endings for Windows scripts
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Dataset and archive files — treat as binary so SHA-256 is never altered
ml/data/*.csv -text
*.zip    binary
